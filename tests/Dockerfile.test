# Lathe test environment — includes all external dependencies
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tesseract-ocr \
    ghostscript \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -e ".[test]"

CMD ["pytest", "-v", "--cov=lathe", "--cov-report=xml", "--cov-fail-under=90"]
